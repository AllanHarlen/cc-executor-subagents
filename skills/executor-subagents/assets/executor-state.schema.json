{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc-executor-subagents/schemas/executor-state.schema.json",
  "title": "Executor run state (state.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "slug",
    "artifactRoot",
    "status",
    "phase",
    "phaseStatus",
    "lastSafePhase",
    "tasks",
    "phaseHistory",
    "repository",
    "lifecycle",
    "resume",
    "createdAt",
    "updatedAt",
    "revision",
    "lastEventId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "layoutVersion": { "type": "integer", "enum": [1, 2] },
    "runId": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "projectConfig": { "$ref": "#/$defs/projectConfigSnapshot" },
    "artifactRoot": { "type": "string" },
    "status": { "$ref": "#/$defs/runStatus" },
    "statusReason": { "type": ["string", "null"] },
    "phase": { "type": "number" },
    "phaseStatus": { "$ref": "#/$defs/phaseStatus" },
    "lastSafePhase": { "type": "number", "minimum": 0 },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "phaseHistory": { "type": "object" },
    "repository": { "type": "object" },
    "lifecycle": {
      "type": "object",
      "required": ["staleIdleSeconds", "staleInToolSeconds", "stallGraceSeconds"],
      "properties": {
        "staleIdleSeconds": { "type": "number", "minimum": 0 },
        "staleInToolSeconds": { "type": "number", "minimum": 0 },
        "stallGraceSeconds": { "type": "number", "minimum": 0 },
        "lastSweepAt": { "type": ["string", "null"] }
      }
    },
    "resume": {
      "type": "object",
      "required": ["count", "resumeFromPhase", "pendingExternalProbes", "recommendations"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "lastResumedAt": { "type": ["string", "null"] },
        "lastReconciledAt": { "type": ["string", "null"] },
        "resumeFromPhase": { "type": "number" },
        "pendingExternalProbes": { "type": "array" },
        "recommendations": { "type": "array" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 },
    "lastEventId": { "type": ["string", "null"] }
  },
  "$defs": {
    "executor": { "enum": ["codex", "agy", "claude-code"] },
    "projectConfigSnapshot": {
      "type": "object",
      "required": ["schemaVersion", "source", "roles"],
      "properties": {
        "schemaVersion": { "type": "integer" },
        "source": { "type": "string" },
        "updatedAt": { "type": ["string", "null"] },
        "roles": {
          "type": "object",
          "required": ["backendExecutor", "frontendExecutor", "backendReviewer", "frontendReviewer"],
          "properties": {
            "backendExecutor": { "$ref": "#/$defs/executor" },
            "frontendExecutor": { "$ref": "#/$defs/executor" },
            "backendReviewer": { "$ref": "#/$defs/executor" },
            "frontendReviewer": { "$ref": "#/$defs/executor" }
          }
        }
      }
    },
    "runStatus": {
      "enum": ["PENDING", "RUNNING", "DONE", "FAILED", "BLOCKED", "STALLED", "CANCELLED", "UNKNOWN"]
    },
    "phaseStatus": {
      "enum": ["PENDING", "RUNNING", "DONE", "FAILED", "BLOCKED", "CANCELLED", "UNKNOWN"]
    },
    "taskStatus": {
      "enum": ["PENDING", "RUNNING", "DONE", "FAILED", "BLOCKED", "STALLED", "CANCELLED", "UNKNOWN"]
    },
    "task": {
      "type": "object",
      "required": ["id", "status", "attempt", "attemptHistory", "apiCalls", "toolCalls", "expectedFiles", "producedFiles", "validations", "evidence", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "executor": { "$ref": "#/$defs/executor" },
        "executorSource": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/taskStatus" },
        "attempt": { "type": "integer", "minimum": 0 },
        "attemptHistory": { "type": "array" },
        "sessionId": { "type": ["string", "null"] },
        "conversationId": { "type": ["string", "null"] },
        "commitBefore": { "type": ["string", "null"] },
        "commitAfter": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"] },
        "completedAt": { "type": ["string", "null"] },
        "lastActivityAt": { "type": ["string", "null"] },
        "apiCalls": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "currentTool": { "type": ["string", "null"] },
        "inTool": { "type": "boolean" },
        "expectedFiles": { "type": "array", "items": { "type": "string" } },
        "producedFiles": { "type": "array", "items": { "type": "string" } },
        "validationPlan": { "type": "array" },
        "validations": { "type": "array" },
        "allowedPaths": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array" },
        "reasonCode": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "reconciliation": { "type": ["object", "null"] },
        "sourcePresent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
